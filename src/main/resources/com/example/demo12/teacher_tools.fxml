<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefWidth="1920.0" prefHeight="1080.0"
            minWidth="1920.0" minHeight="1080.0"
            style="-fx-background-color: #F0F7F4;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo12.TeacherToolsController">

    <children>

        <TabPane layoutX="15.0" layoutY="25.0"
                 prefWidth="800.0" prefHeight="890.0"
                 tabClosingPolicy="UNAVAILABLE"
                 style="-fx-font-size: 15px;">

            <tabs>

                <!-- ВКЛАДКА 1: ДОМАШНИЕ ЗАДАНИЯ -->
                <Tab text="Домашние задания">
                    <content>
                        <AnchorPane style="-fx-background-color: #F0F7F4;">
                            <Label layoutX="15.0" layoutY="20.0" text="Группа:" style="-fx-font-size: 16px;"/>
                            <ComboBox fx:id="homeworkGroupCombo" layoutX="140.0" layoutY="15.0" prefWidth="260.0"/>

                            <Label layoutX="15.0" layoutY="70.0" text="Предмет:" style="-fx-font-size: 16px;"/>
                            <ComboBox fx:id="homeworkSubjectCombo" layoutX="140.0" layoutY="65.0" prefWidth="260.0"/>

                            <Label layoutX="15.0" layoutY="125.0" text="Описание:" style="-fx-font-size: 16px;"/>
                            <TextArea fx:id="homeworkDescriptionArea" layoutX="140.0" layoutY="115.0" prefWidth="450.0" prefHeight="100.0" wrapText="true"/>

                            <Label layoutX="15.0" layoutY="245.0" text="Срок сдачи:" style="-fx-font-size: 16px;"/>
                            <DatePicker fx:id="dueDatePicker" layoutX="140.0" layoutY="235.0" prefWidth="260.0"/>

                            <Button fx:id="addHomeworkButton" layoutX="15.0" layoutY="295.0" prefWidth="200.0" prefHeight="45.0" onAction="#addHomework" text="Добавить" style="-fx-background-color: #80CBC4; -fx-font-size: 18px;"/>

                            <Label layoutX="15.0" layoutY="360.0" text="Список домашних заданий:" style="-fx-font-size: 18px;"/>
                            <ListView fx:id="homeworkListView" layoutX="15.0" layoutY="395.0" prefWidth="740.0" prefHeight="420.0"/>
                        </AnchorPane>
                    </content>
                </Tab>

                <!-- ВКЛАДКА 2: НАПОМИНАНИЯ -->
                <Tab text="Напоминания">
                    <content>
                        <AnchorPane style="-fx-background-color: #F0F7F4;">
                            <Label layoutX="15.0" layoutY="20.0" text="Группа:" style="-fx-font-size: 16px;"/>
                            <ComboBox fx:id="reminderGroupCombo" layoutX="140.0" layoutY="15.0" prefWidth="260.0"/>

                            <Label layoutX="15.0" layoutY="70.0" text="День недели:" style="-fx-font-size: 16px;"/>
                            <ComboBox fx:id="reminderDayCombo" layoutX="140.0" layoutY="65.0" prefWidth="260.0"/>

                            <Label layoutX="15.0" layoutY="120.0" text="Пара:" style="-fx-font-size: 16px;"/>
                            <ComboBox fx:id="reminderLessonCombo" layoutX="140.0" layoutY="115.0" prefWidth="260.0"/>

                            <Label layoutX="15.0" layoutY="175.0" text="Текст:" style="-fx-font-size: 16px;"/>
                            <TextArea fx:id="reminderMessageArea" layoutX="140.0" layoutY="165.0" prefWidth="450.0" prefHeight="100.0" wrapText="true"/>

                            <Label layoutX="15.0" layoutY="295.0" text="Дата:" style="-fx-font-size: 16px;"/>
                            <DatePicker fx:id="reminderDatePicker" layoutX="140.0" layoutY="285.0" prefWidth="260.0"/>

                            <Button fx:id="addReminderButton" layoutX="15.0" layoutY="345.0" prefWidth="200.0" prefHeight="45.0" onAction="#addReminder" text="Добавить" style="-fx-background-color: #FFB74D; -fx-font-size: 18px;"/>

                            <Label layoutX="15.0" layoutY="410.0" text="Список напоминаний:" style="-fx-font-size: 18px;"/>
                            <ListView fx:id="reminderListView" layoutX="15.0" layoutY="445.0" prefWidth="740.0" prefHeight="370.0"/>
                        </AnchorPane>
                    </content>
                </Tab>

                <!-- ВКЛАДКА 3: УЧЕБНЫЕ МАТЕРИАЛЫ -->
                <Tab text="Учебные материалы">
                    <content>
                        <AnchorPane style="-fx-background-color: #F0F7F4;">
                            <Label layoutX="15.0" layoutY="20.0" text="Группа:" style="-fx-font-size: 16px;"/>
                            <ComboBox fx:id="materialGroupCombo" layoutX="140.0" layoutY="15.0" prefWidth="260.0"/>

                            <Label layoutX="15.0" layoutY="70.0" text="Предмет:" style="-fx-font-size: 16px;"/>
                            <ComboBox fx:id="materialSubjectCombo" layoutX="140.0" layoutY="65.0" prefWidth="260.0"/>

                            <Label layoutX="15.0" layoutY="120.0" text="Тип материала:" style="-fx-font-size: 16px;"/>
                            <ComboBox fx:id="materialTypeCombo" layoutX="140.0" layoutY="115.0" prefWidth="260.0"/>

                            <Label layoutX="15.0" layoutY="170.0" text="Название:" style="-fx-font-size: 16px;"/>
                            <TextField fx:id="materialTitleField" layoutX="140.0" layoutY="165.0" prefWidth="400.0"/>

                            <Label layoutX="15.0" layoutY="225.0" text="Описание:" style="-fx-font-size: 16px;"/>
                            <TextArea fx:id="materialDescriptionArea" layoutX="140.0" layoutY="215.0" prefWidth="450.0" prefHeight="100.0" wrapText="true"/>

                            <Button fx:id="uploadMaterialButton" layoutX="15.0" layoutY="335.0" prefWidth="230.0" prefHeight="45.0" onAction="#uploadMaterial" text="Загрузить файл" style="-fx-background-color: #64B5F6; -fx-font-size: 18px;"/>

                            <Label layoutX="15.0" layoutY="400.0" text="Доступные материалы:" style="-fx-font-size: 18px;"/>
                            <ListView fx:id="materialsListView" layoutX="15.0" layoutY="435.0" prefWidth="740.0" prefHeight="380.0"/>
                        </AnchorPane>
                    </content>
                </Tab>

                <!-- ВКЛАДКА 4: МОЯ НАГРУЗКА -->
                <Tab text="Моя нагрузка">
                    <content>
                        <AnchorPane style="-fx-background-color: #F0F7F4;">
                            <Label layoutX="15.0" layoutY="20.0" text="Сводка по нагрузке:" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <Label fx:id="workloadSummaryLabel" layoutX="15.0" layoutY="55.0" prefWidth="740.0" prefHeight="120.0" wrapText="true" style="-fx-font-size: 16px;"/>

                            <Label layoutX="15.0" layoutY="185.0" text="Детализация по парам:" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                            <ListView fx:id="workloadListView" layoutX="15.0" layoutY="220.0" prefWidth="740.0" prefHeight="600.0"/>
                        </AnchorPane>
                    </content>
                </Tab>

            </tabs>
        </TabPane>

        <!-- ПРАВАЯ ЧАСТЬ: ПОИСК СВОБОДНЫХ КАБИНЕТОВ -->
        <Label layoutX="970.0" layoutY="40.0" prefWidth="920.0" alignment="CENTER" text="Дополнительные функции" textFill="#1E2A2A" style="-fx-font-size: 22px;"/>
        <Label layoutX="970.0" layoutY="90.0" prefWidth="920.0" alignment="CENTER" text="ПОИСК СВОБОДНЫХ КАБИНЕТОВ" textFill="#1E2A2A" style="-fx-font-size: 20px;"/>

        <Label layoutX="1020.0" layoutY="160.0" text="Тип кабинета:" style="-fx-font-size: 18px;"/>
        <ComboBox fx:id="classroomTypeCombo" layoutX="1180.0" layoutY="150.0" prefWidth="350.0" prefHeight="40.0" promptText="Выберите тип"/>

        <Label layoutX="1020.0" layoutY="225.0" text="День недели:" style="-fx-font-size: 18px;"/>
        <ComboBox fx:id="classroomDayCombo" layoutX="1180.0" layoutY="215.0" prefWidth="350.0" prefHeight="40.0" promptText="Выберите день"/>

        <Label layoutX="1020.0" layoutY="290.0" text="Номер пары:" style="-fx-font-size: 18px;"/>
        <ComboBox fx:id="classroomLessonCombo" layoutX="1180.0" layoutY="280.0" prefWidth="350.0" prefHeight="40.0" promptText="Выберите пару"/>

        <Button fx:id="searchClassroomButton" layoutX="1180.0" layoutY="350.0" prefWidth="220.0" prefHeight="50.0" onAction="#searchFreeClassrooms" text="Найти кабинеты" style="-fx-background-color: #80CBC4; -fx-font-size: 18px;"/>

        <Label layoutX="1020.0" layoutY="420.0" text="Результаты поиска:" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        <ListView fx:id="classroomSearchResultList" layoutX="1020.0" layoutY="450.0" prefWidth="800.0" prefHeight="450.0"/>

        <Button fx:id="backButton" layoutX="14.0" layoutY="950.0" prefWidth="130.0" prefHeight="55.0" onAction="#goBack" mnemonicParsing="false" style="-fx-background-color: #80CBC4; -fx-font-size: 20px;" text="Назад" textFill="#1E2A2A"/>

    </children>
</AnchorPane>