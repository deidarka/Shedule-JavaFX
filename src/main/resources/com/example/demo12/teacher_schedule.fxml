<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="1080.0" prefWidth="1920.0" style="-fx-background-color: #F0F7F4;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo12.TeacherScheduleController">
    <children>
        <Label layoutX="712.0" layoutY="14.0" prefHeight="45.0" prefWidth="497.0" text="Расписание занятий преподавателя" textFill="#1E2A2A">
            <font>
                <Font size="30.0" />
            </font>
        </Label>

        <Label layoutX="20.0" layoutY="80.0"
               prefWidth="215.0" prefHeight="30.0"
               text="ФИО преподавателя:"
               textFill="#1E2A2A">
            <font>
                <Font size="22.0"/>
            </font>
        </Label>

        <Label fx:id="teacherNameLabel"
               layoutX="240.0" layoutY="80.0"
               prefWidth="600.0" prefHeight="30.0"
               text="" textFill="#1E2A2A">
            <font>
                <Font size="22.0"/>
            </font>
        </Label>

        <Label layoutX="20.0" layoutY="115.0"
               prefWidth="120.0" prefHeight="30.0"
               text="Предметы:"
               textFill="#1E2A2A">
            <font>
                <Font size="22.0"/>
            </font>
        </Label>

        <Label fx:id="subjectsLabel"
               layoutX="150.0" layoutY="115.0"
               prefWidth="1600.0" prefHeight="30.0"
               text="" textFill="#1E2A2A">
            <font>
                <Font size="20.0"/>
            </font>
        </Label>

        <!-- Кнопки дней недели -->
        <Button fx:id="mondayButton" layoutX="48.0" layoutY="160.0" mnemonicParsing="false" prefHeight="52.0" prefWidth="192.0" style="-fx-background-color: #80CBC4;" text="Понедельник" textFill="#1E2A2A">
            <font>
                <Font size="25.0" />
            </font>
        </Button>
        <Button fx:id="tuesdayButton" layoutX="270.0" layoutY="160.0" mnemonicParsing="false" prefHeight="52.0" prefWidth="157.0" style="-fx-background-color: #80CBC4;" text="Вторник" textFill="#1E2A2A">
            <font>
                <Font size="25.0" />
            </font>
        </Button>
        <Button fx:id="wednesdayButton" layoutX="447.0" layoutY="160.0" mnemonicParsing="false" prefHeight="52.0" prefWidth="157.0" style="-fx-background-color: #80CBC4;" text="Среда" textFill="#1E2A2A">
            <font>
                <Font size="25.0" />
            </font>
        </Button>
        <Button fx:id="thursdayButton" layoutX="634.0" layoutY="160.0" mnemonicParsing="false" prefHeight="52.0" prefWidth="157.0" style="-fx-background-color: #80CBC4;" text="Четверг" textFill="#1E2A2A">
            <font>
                <Font size="25.0" />
            </font>
        </Button>
        <Button fx:id="fridayButton" layoutX="804.0" layoutY="160.0" mnemonicParsing="false" prefHeight="52.0" prefWidth="157.0" style="-fx-background-color: #80CBC4;" text="Пятница" textFill="#1E2A2A">
            <font>
                <Font size="25.0" />
            </font>
        </Button>

        <!-- Само расписание (уменьшена высота, чтобы влезли уведомления) -->
        <Label fx:id="scheduleLabel"
               layoutX="49.0" layoutY="226.0"
               prefWidth="1600.0" prefHeight="460.0"
               style="-fx-background-color: #F0F7F4;"
               textFill="#1E2A2A"
               wrapText="true">
            <font>
                <Font size="20.0"/>
            </font>
        </Label>

        <!-- Уведомления об изменениях (теперь под расписанием) -->
        <!-- Уведомления об изменениях (теперь под расписанием) -->
        <Label layoutX="49.0" layoutY="700.0"
               text="Уведомления об изменениях в расписании:"
               textFill="#1E2A2A"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <Label fx:id="teacherNotificationLabel"
               layoutX="49.0"
               layoutY="735.0"
               prefWidth="1050.0"
               prefHeight="150.0"
               wrapText="true"
               text="Изменений в расписании нет."
               textFill="#1E2A2A"
               style="-fx-font-size: 16px; -fx-background-color: #E8F0EC; -fx-padding: 10px; -fx-border-color: #80CBC4; -fx-border-radius: 5px;"/>

        <!-- Кнопки внизу -->
        <Button fx:id="toolsButton" layoutX="240.0" layoutY="939.0" mnemonicParsing="false" onAction="#openTeacherTools" prefHeight="62.0" prefWidth="217.0" style="-fx-background-color: #FFB74D;" text="Инструменты" textFill="#1E2A2A">
            <font>
                <Font size="27.0" />
            </font></Button>

        <Button fx:id="backButton" layoutX="30.0" layoutY="939.0" mnemonicParsing="false" onMouseClicked="#goBack" prefHeight="62.0" prefWidth="140.0" style="-fx-background-color: #80CBC4;" text="Назад" textFill="#1E2A2A">
            <font>
                <Font size="27.0" />
            </font></Button>
    </children>
</AnchorPane>