<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.shape.Line?>
<AnchorPane prefWidth="1920.0" prefHeight="1080.0"
            minWidth="1920.0" minHeight="1080.0"
            style="-fx-background-color: #F0F7F4;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.demo12.StudentScheduleController">

    <children>

        <Label fx:id="groupNameLabel"
               layoutX="0.0" layoutY="15.0"
               prefWidth="1920.0" prefHeight="35.0"
               alignment="CENTER"
               textFill="#1E2A2A">
            <font>
                <Font size="22.0"/>
            </font>
        </Label>
        <Label fx:id="scheduleNotificationLabel"
               layoutX="850.0" layoutY="100.0"
               prefWidth="1000.0" prefHeight="150.0"
               wrapText="true"
               text="Изменения расписания"
               textFill="#1E2A2A"
               style="-fx-font-size: 18px;"/>

        <TabPane layoutX="15.0" layoutY="80.0"
                 prefWidth="800.0" prefHeight="835.0"
                 tabClosingPolicy="UNAVAILABLE"
                 style="-fx-font-size: 15px;">

            <tabs>

                <Tab text="Расписание">
                    <content>
                        <AnchorPane fx:id="schedulePane"
                                    prefWidth="790.0"
                                    prefHeight="800.0"
                                    style="-fx-background-color: #F0F7F4;"/>
                    </content>
                </Tab>

                <Tab text="Домашние задания">
                    <content>
                        <AnchorPane style="-fx-background-color: #F0F7F4;">
                            <Label layoutX="15.0" layoutY="15.0" text="ДОМАШНИЕ ЗАДАНИЯ" textFill="#1E2A2A" style="-fx-font-size: 14px;"/>
                            <Line startX="10.0" startY="40.0" endX="750.0" endY="40.0" stroke="#607D75" strokeWidth="1.2"/>
                            <Label fx:id="homeworkLabel" layoutX="15.0" layoutY="55.0" prefWidth="740.0" wrapText="true" textFill="#1E2A2A" style="-fx-font-size: 14px;"/>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab text="Напоминания">
                    <content>
                        <AnchorPane style="-fx-background-color: #F0F7F4;">
                            <Label layoutX="15.0" layoutY="15.0" text="НАПОМИНАНИЯ" textFill="#1E2A2A" style="-fx-font-size: 14px;"/>
                            <Line startX="10.0" startY="40.0" endX="750.0" endY="40.0" stroke="#607D75" strokeWidth="1.2"/>
                            <Label fx:id="reminderLabel" layoutX="15.0" layoutY="55.0" prefWidth="740.0" wrapText="true" textFill="#1E2A2A" style="-fx-font-size: 14px;"/>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab text="Материалы">
                    <content>
                        <AnchorPane style="-fx-background-color: #F0F7F4;">
                            <Label layoutX="15.0" layoutY="15.0" text="Доступные материалы (двойной клик для скачивания):" textFill="#1E2A2A" style="-fx-font-size: 14px;"/>
                            <Line startX="10.0" startY="40.0" endX="750.0" endY="40.0" stroke="#607D75" strokeWidth="1.2"/>
                            <ListView fx:id="materialsListView" layoutX="15.0" layoutY="55.0" prefWidth="740.0" prefHeight="700.0" style="-fx-background-color: #E0ECE6;"/>
                        </AnchorPane>
                    </content>
                </Tab>

                <Tab text="Поиск преподавателя">
                    <content>
                        <AnchorPane style="-fx-background-color: #F0F7F4;">
                            <!-- Надпись и ComboBox в одну строку -->
                            <Label layoutX="15.0" layoutY="15.0" text="Выберите преподавателя:" textFill="#1E2A2A" style="-fx-font-size: 14px;"/>
                            <ComboBox fx:id="teacherSearchCombo" layoutX="195.0" layoutY="10.0" prefWidth="400.0" promptText="ФИО преподавателя"/>

                            <Line startX="10.0" startY="50.0" endX="730.0" endY="50.0" stroke="#607D75" strokeWidth="1.2"/>

                            <!-- Подняли расписание наверх и дали ему больше высоты -->
                            <AnchorPane fx:id="teacherSearchPane" layoutX="15.0" layoutY="60.0" prefWidth="740.0" prefHeight="740.0" />
                        </AnchorPane>
                    </content>
                </Tab>

            </tabs>
        </TabPane>

        <Button fx:id="backButton"
                layoutX="14.0" layoutY="950.0"
                prefWidth="130.0" prefHeight="55.0"
                onAction="#goBack"
                mnemonicParsing="false"
                style="-fx-background-color: #80CBC4; -fx-font-size: 20px;"
                text="Назад"
                textFill="#1E2A2A"/>

    </children>
</AnchorPane>